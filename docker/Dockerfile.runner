# syntax=docker/dockerfile:1
# Actions runner. Jobs run as sibling containers through the host docker daemon,
# so the job work tree must sit at the same path inside this container and on the
# host, and the registration must live on a volume:
#
#   docker run --rm -v dfcli-runner-home:/home/runner \
#     distroface-runner register --server https://df.example.com --token dfr_... --name ci
#   docker run -d --name dfcli-runner \
#     -v /var/run/docker.sock:/var/run/docker.sock \
#     -v /var/lib/dfcli-runner:/var/lib/dfcli-runner \
#     -v dfcli-runner-home:/home/runner \
#     distroface-runner
#
# Jobs run through act. Each job gets its own directory under the work dir
# holding the checkout act copies into the job container, a docker config that
# carries the job token for the instance registry, and the files an agent
# session exchanges with its command step. Remote actions are cloned once into
# _actions under the work dir and shared by every job. The runner pulls the job
# and service images through the host daemon before act starts, and act keeps
# the tool cache in the act-toolcache volume mounted at /opt/hostedtoolcache.
ARG APP_VERSION=dev

FROM --platform=$BUILDPLATFORM bufbuild/buf:latest AS proto-builder
WORKDIR /app
COPY buf.yaml buf.gen.yaml ./
COPY proto/ ./proto/
RUN mkdir -p web/distroface/static pkg/proto web/distroface/src/lib/proto && buf generate

FROM golang:1.26-alpine AS builder

ARG APP_VERSION
ARG TARGETOS
ARG TARGETARCH

WORKDIR /app

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY . .
COPY --from=proto-builder /app/pkg/proto ./pkg/proto/

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -ldflags "-s -w -X main.Version=${APP_VERSION}" -o dfcli ./cmd/dfcli

FROM alpine:latest

RUN apk --no-cache add ca-certificates git

# Root inside the container, the docker socket it drives is root on the host anyway
WORKDIR /home/runner
COPY --from=builder /app/dfcli /usr/local/bin/dfcli

# Registration persists on the home volume, job trees share one host path
ENV DFCLI_RUNNER_CONFIG=/home/runner/runner.json \
    DFCLI_RUNNER_WORK_DIR=/var/lib/dfcli-runner
VOLUME ["/home/runner"]
RUN mkdir -p /var/lib/dfcli-runner

ENTRYPOINT ["dfcli", "runner"]
CMD ["start"]
