# syntax=docker/dockerfile:1
ARG APP_VERSION=dev

FROM --platform=$BUILDPLATFORM bufbuild/buf:latest AS proto-builder
WORKDIR /app
COPY buf.yaml buf.gen.yaml ./
COPY proto/ ./proto/
RUN mkdir -p web/distroface/static pkg/proto web/distroface/src/lib/proto && buf generate

FROM golang:1.26-alpine AS builder

ARG APP_VERSION
ARG TARGETOS
ARG TARGETARCH

WORKDIR /app

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY . .
COPY --from=proto-builder /app/pkg/proto ./pkg/proto/

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -ldflags "-s -w -X main.Version=${APP_VERSION}" -o dfcli ./cmd/dfcli

FROM alpine:latest

RUN apk --no-cache add ca-certificates git

RUN addgroup -g 1000 -S runner && \
    adduser -u 1000 -S -G runner -h /home/runner -s /sbin/nologin runner

WORKDIR /home/runner

COPY --from=builder /app/dfcli /usr/local/bin/dfcli

# Jobs run in sibling containers through the mounted docker socket
ENV DFCLI_RUNNER_CONFIG=/home/runner/runner.json

USER 1000:1000

ENTRYPOINT ["dfcli", "runner"]
CMD ["start"]
